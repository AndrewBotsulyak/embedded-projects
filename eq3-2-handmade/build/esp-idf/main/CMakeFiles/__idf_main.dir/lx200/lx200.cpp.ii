static const char *TAG = "lx200";
# 22 "/Users/andrew/embedded/pet-projects/eq3-2-handmade/main/lx200/lx200.cpp"
typedef size_t (*lx200_handler_t)(lx200_ctx_t *ctx, const char *cmd, char *reply, size_t size);

typedef struct {
    const char *name;
    bool has_args;

    lx200_handler_t handler;
} lx200_cmd_t;


static size_t copy_reply(const char *text, char *reply, size_t size) {
    size_t n = strlen(text);
    if (n + 1 > size) return 0;
    memcpy(reply, text, n + 1);
    return n;
}

static mount_dir_t to_mount_dir(lx200_dir_t dir) {
    switch (dir) {
        case LX200_DIR_N: return MOUNT_DIR_N;
        case LX200_DIR_S: return MOUNT_DIR_S;
        case LX200_DIR_E: return MOUNT_DIR_E;
        case LX200_DIR_W: return MOUNT_DIR_W;
    }
    return MOUNT_DIR_N;
}

static mount_rate_t to_mount_rate(lx200_rate_t rate) {
    switch (rate) {
        case LX200_RATE_GUIDE: return MOUNT_RATE_GUIDE;
        case LX200_RATE_CENTER: return MOUNT_RATE_CENTER;
        case LX200_RATE_FIND: return MOUNT_RATE_FIND;
        case LX200_RATE_SLEW: return MOUNT_RATE_SLEW;
    }
    return MOUNT_RATE_SLEW;
}




static size_t cmd_move(lx200_ctx_t *, const char *cmd, char *, size_t) {
    lx200_dir_t dir;
    if (lx200_dir_from_char(cmd[1], &dir)) {
        mount_move(to_mount_dir(dir));
    }
    return 0;
}


static size_t cmd_stop_dir(lx200_ctx_t *, const char *cmd, char *, size_t) {
    lx200_dir_t dir;
    if (lx200_dir_from_char(cmd[1], &dir)) {
        mount_stop(to_mount_dir(dir));
    }
    return 0;
}


static size_t cmd_stop_all(lx200_ctx_t *, const char *, char *, size_t) {
    mount_stop_all();
    return 0;
}


static size_t cmd_rate(lx200_ctx_t *, const char *cmd, char *, size_t) {
    lx200_rate_t rate;
    if (lx200_rate_from_char(cmd[1], &rate)) {
        mount_set_rate(to_mount_rate(rate));
    }
    return 0;
}





static size_t cmd_track(lx200_ctx_t *, const char *cmd, char *reply, size_t size) {
    esp_err_t err = mount_track(cmd[1] == 'e');
    return copy_reply(err == 0 ? "1" : "0", reply, size);
}


static const lx200_cmd_t COMMANDS[] = {
    { "Mn", false, cmd_move },
    { "Ms", false, cmd_move },
    { "Me", false, cmd_move },
    { "Mw", false, cmd_move },
    { "Qn", false, cmd_stop_dir },
    { "Qs", false, cmd_stop_dir },
    { "Qe", false, cmd_stop_dir },
    { "Qw", false, cmd_stop_dir },
    { "Q", false, cmd_stop_all },
    { "RG", false, cmd_rate },
    { "RC", false, cmd_rate },
    { "RM", false, cmd_rate },
    { "RS", false, cmd_rate },
    { "Te", false, cmd_track },
    { "Td", false, cmd_track },
};


