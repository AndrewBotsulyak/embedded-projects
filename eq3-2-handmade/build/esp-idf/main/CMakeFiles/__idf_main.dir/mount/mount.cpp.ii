enum e_motion_cmd_t {
    CMD_SET_RATE,
    CMD_MOVE,
    CMD_STOP,
    CMD_TRACK,
    CMD_GOTO,
    CMD_ABORT,
};


enum motion_rate_t {
    MOTION_RATE_GUIDE,
    MOTION_RATE_CENTER,
    MOTION_RATE_FIND,
    MOTION_RATE_SLEW,
};


enum motion_state_t {
    MOTION_STATE_IDLE,
    MOTION_STATE_TRACKING,
    MOTION_STATE_GOTO,
    MOTION_STATE_FAULT,
};


typedef struct {
    e_motion_cmd_t cmd;
    axis_t axis;
    bool isForward;
    bool on;
    motion_rate_t rate;
    int32_t target[AXIS_COUNT];
} motion_cmd_t;



esp_err_t motion_start();


esp_err_t motion_send(motion_cmd_t cmd, uint32_t timeout = 0);



esp_err_t motion_set_rate(motion_rate_t rate);
esp_err_t motion_move(axis_t a, bool forward);
esp_err_t motion_stop(axis_t a);
esp_err_t motion_track(bool on);
esp_err_t motion_goto(int32_t ra_steps, int32_t dec_steps);
esp_err_t motion_abort();


motion_state_t motion_get_state();
