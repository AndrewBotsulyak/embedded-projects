# 41 "/Users/andrew/embedded/pet-projects/eq3-2-handmade/main/tmc-driver/tmc-current.h"
constexpr uint32_t TMC_VSENSE = 1;

constexpr uint32_t TMC_V_FS_MV = TMC_VSENSE ? 180 : 325;
constexpr uint32_t TMC_R_SENSE_MOHM = 110;
constexpr uint32_t TMC_R_INTERNAL_MOHM = 20;





constexpr uint32_t TMC_FULL_SCALE_MA =
    TMC_V_FS_MV * 1000 / (TMC_R_SENSE_MOHM + TMC_R_INTERNAL_MOHM)
    * 1000 / 1414;
# 66 "/Users/andrew/embedded/pet-projects/eq3-2-handmade/main/tmc-driver/tmc-current.h"
constexpr uint8_t tmc_ma_to_cs(uint32_t ma)
{
    uint32_t steps = ma * 32 / TMC_FULL_SCALE_MA;

    if (steps == 0) return 0;
    if (steps > 32) return 31;
    return steps - 1;
}







constexpr uint32_t tmc_cs_to_ma(uint8_t cs)
{
    return (cs + 1) * TMC_FULL_SCALE_MA / 32;
}
# 10 "/Users/andrew/embedded/pet-projects/eq3-2-handmade/main/axis-config.h" 2
# 23 "/Users/andrew/embedded/pet-projects/eq3-2-handmade/main/axis-config.h"
enum axis_t {
    AXIS_RA = 0,
    AXIS_DEC = 1,
    AXIS_COUNT
};

struct axis_config_t {
    const char *name;


    uint8_t uart_addr;
    gpio_num_t en_pin;
    gpio_num_t step_pin;
    gpio_num_t dir_pin;


    uint8_t irun;
    uint8_t ihold;
    uint8_t irun_hot;
    uint8_t pwm_grad;
    uint8_t mres;
    bool shaft;


    uint32_t full_steps;
    uint32_t microsteps;
    uint32_t worm_teeth;
    uint32_t belt_ratio;
};



inline constexpr axis_config_t AXES[AXIS_COUNT] = {
    {
        .name = "RA",
        .uart_addr = 0,
        .en_pin = GPIO_NUM_6,
        .step_pin = GPIO_NUM_5,
        .dir_pin = GPIO_NUM_4,
        .irun = tmc_ma_to_cs(720),
        .ihold = tmc_ma_to_cs(350),
        .irun_hot = tmc_ma_to_cs(600),
        .pwm_grad = 36,
        .mres = 2,
        .shaft = false,
        .full_steps = 200,
        .microsteps = 64,
        .worm_teeth = 130,
        .belt_ratio = 3,
    },
    {
        .name = "DEC",
        .uart_addr = 1,
        .en_pin = GPIO_NUM_16,
        .step_pin = GPIO_NUM_21,
        .dir_pin = GPIO_NUM_14,
        .irun = tmc_ma_to_cs(720),
        .ihold = tmc_ma_to_cs(350),
        .irun_hot = tmc_ma_to_cs(600),
        .pwm_grad = 36,
        .mres = 2,
        .shaft = false,
        .full_steps = 200,
        .microsteps = 64,
        .worm_teeth = 65,
        .belt_ratio = 3,
    },
};






constexpr uint32_t axis_motor_steps_per_rev(axis_t a)
{
    return AXES[a].full_steps * AXES[a].microsteps;
}


constexpr uint64_t axis_steps_per_rev(axis_t a)
{
    return (uint64_t)AXES[a].full_steps * AXES[a].microsteps
         * AXES[a].worm_teeth * AXES[a].belt_ratio;
}
# 118 "/Users/andrew/embedded/pet-projects/eq3-2-handmade/main/axis-config.h"
constexpr uint32_t axis_sidereal_mhz(axis_t a)
{
    constexpr uint64_t SIDEREAL_DAY_X10000 = 861640905ULL;
    return (uint32_t)((axis_steps_per_rev(a) * 10000000ULL + SIDEREAL_DAY_X10000 / 2)
                      / SIDEREAL_DAY_X10000);
}






constexpr bool axis_microsteps_match(axis_t a)
{
    return AXES[a].mres <= 8 && AXES[a].microsteps == (256u >> AXES[a].mres);
}

constexpr bool axis_currents_ok(axis_t a)
{
    return AXES[a].irun >= 16
        && AXES[a].ihold > 0
        && AXES[a].ihold <= AXES[a].irun
        && AXES[a].irun_hot >= 16
        && AXES[a].irun_hot < AXES[a].irun
        && AXES[a].ihold <= AXES[a].irun_hot;
}

static_assert(axis_microsteps_match(AXIS_RA), "RA: microsteps не совпадает с MRES (256 >> MRES)");
static_assert(axis_microsteps_match(AXIS_DEC), "DEC: microsteps не совпадает с MRES (256 >> MRES)");
static_assert(axis_currents_ok(AXIS_RA), "RA: проверь токи (IRUN, IHOLD, IRUN_HOT)");
static_assert(axis_currents_ok(AXIS_DEC), "DEC: проверь токи (IRUN, IHOLD, IRUN_HOT)");
static_assert(AXES[AXIS_RA].uart_addr != AXES[AXIS_DEC].uart_addr, "у осей одинаковый адрес UART");
static_assert(AXES[AXIS_RA].uart_addr <= 3 && AXES[AXIS_DEC].uart_addr <= 3, "адрес TMC2209 — 0..3");



static_assert(axis_steps_per_rev(AXIS_RA) == 4992000, "RA: шагов на оборот изменилось");
static_assert(axis_sidereal_mhz(AXIS_RA) == 57936, "RA: скорость ведения изменилась");
