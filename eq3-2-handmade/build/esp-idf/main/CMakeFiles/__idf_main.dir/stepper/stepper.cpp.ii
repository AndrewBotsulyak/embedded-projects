void stepper_stop(axis_t a) {
    FastAccelStepper *stepper = steppers[a];
    if (stepper == nullptr) return;

    stepper->stopMove();
    while (stepper->isRunning()) {
        vTaskDelay(( ( TickType_t ) ( ( ( TickType_t ) ( 10 ) * ( TickType_t ) 
