static int32_t rate_speed_mhz(axis_t a) {
    const int32_t sidereal = (int32_t)axis_sidereal_mhz(a);
    switch (rate) {
        case MOTION_RATE_GUIDE: return sidereal / 2;
        case MOTION_RATE_CENTER: return sidereal * 8;
        case MOTION_RATE_FIND: return sidereal * 64;
        case MOTION_RATE_SLEW: break;
    }
    return (int32_t)stepper_slew_speed_mhz(a);
}
