static void apply_all_axes() {
    for (int i = 0; i < AXIS_COUNT; i++) {
        apply_axis((axis_t)i);
    }
}

static void clear_manual() {
    for (int i = 0; i < AXIS_COUNT; i++) {
        manual[i].moving = false;
    }
}


