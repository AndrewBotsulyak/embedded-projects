{
    "version": 3,
    "configurePresets": [
        {
            "name": "dev",
            "displayName": "Development",
            "binaryDir": "build/dev",
            "cacheVariables": {
                "SDKCONFIG_DEFAULTS": "sdkconfig.defaults;sdkconfig.defaults.dev",
                "SDKCONFIG": "./build/dev/sdkconfig"
            }
        },
        {
            "name": "prod",
            "displayName": "Production",
            "binaryDir": "build/prod",
            "cacheVariables": {
                "SDKCONFIG_DEFAULTS": "sdkconfig.defaults;sdkconfig.defaults.prod",
                "SDKCONFIG": "./build/prod/sdkconfig"
            }
        }
    ]
}
